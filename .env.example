# Copy this file to .env.local and fill in values from the isolated
# `rls-red-alert-demo` Supabase project. Never commit .env.local.
#
# These are safe to expose to the browser (Supabase anon/publishable keys
# are designed to be public and rely on RLS policies for protection --
# which is exactly what this demo intentionally breaks).
NEXT_PUBLIC_SUPABASE_URL=https://mcmtazachjcyoimujvpt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# This app never uses a service-role key. The demo's public.clients table,
# RLS policy, and the two synthetic trainer accounts (Trainer A / "Bob" and
# Trainer B) are provisioned and owned by the separate Vibe Fixer pipeline
# (see its scripts/setup-demo-environment.mjs), not by this repository.
